# Адрес бэкенда (server.js на Railway). Не трогаем бэкенд, только читаем.
NEXT_PUBLIC_BACKEND_URL=https://web-production-9faf3.up.railway.app

# Публичный переключатель; здесь никогда не должно быть секретных ключей Stripe.
